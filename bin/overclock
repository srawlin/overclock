#!/usr/bin/env bash
# overclock — pi-coding-agent harness tuned for Cerebras (small-context model, fast inference)
set -euo pipefail

# Resolve symlinks — the installer links ~/.local/bin/overclock -> here, and
# BASH_SOURCE reports the link path, not the target (F3).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
	dir="$(cd "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="$dir/$SOURCE"
done
HERE="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# One-time rename migration: adopt the old fastcode state dir if it exists.
if [ ! -d "$HOME/.overclock" ] && [ -d "$HOME/.fastcode" ]; then
	mv "$HOME/.fastcode" "$HOME/.overclock"
fi

# Separate agent state (sessions, auth, settings) from a stock pi install.
# pi is rebranded via piConfig (scripts/postinstall.mjs): its agent-dir env var
# is OVERCLOCK_CODING_AGENT_DIR. PI_CODING_AGENT_DIR and our own
# OVERCLOCK_/FASTCODE_AGENT_DIR are honored as fallbacks; both names are
# exported so pi and our metrics code agree on the resolved dir.
AGENT_DIR="${OVERCLOCK_CODING_AGENT_DIR:-${PI_CODING_AGENT_DIR:-${OVERCLOCK_AGENT_DIR:-${FASTCODE_AGENT_DIR:-$HOME/.overclock/agent}}}}"
export OVERCLOCK_CODING_AGENT_DIR="$AGENT_DIR"
export PI_CODING_AGENT_DIR="$AGENT_DIR"
mkdir -p "$AGENT_DIR"

# First-run defaults; user-editable afterwards.
if [ ! -f "$AGENT_DIR/settings.json" ]; then
	cat > "$AGENT_DIR/settings.json" <<'JSON'
{
  "defaultProvider": "cerebras",
  "defaultModel": "cerebras/qwen-3.8-27b",
  "defaultThinkingLevel": "low",
  "quietStartup": true
}
JSON
fi

# API key: existing env wins, else ~/.config/overclock/env (legacy:
# ~/.config/fastcode/env), else CEREBRAS_API_KEY parsed from ./.env.
#
# The ~/.config files are user-controlled (same trust as ~/.zshrc), so they are
# sourced — arbitrary OVERCLOCK_* knobs work there. A repo-local .env is NOT
# safe to execute: it would run attacker code at launch, and could silently set
# OVERCLOCK_API_BASE to redirect requests (and the key) to a hostile endpoint
# (F1). Parse the key out of it instead — the file can never supply anything
# else, and it can never override a key already configured by the user.
if [ -z "${CEREBRAS_API_KEY:-}" ]; then
	for f in "$HOME/.config/fastcode/env" "$HOME/.config/overclock/env"; do
		if [ -f "$f" ]; then
			set -a; . "$f"; set +a
		fi
	done
	if [ -z "${CEREBRAS_API_KEY:-}" ] && [ -f ./.env ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			line="${line#"${line%%[![:space:]]*}"}"
			case "$line" in
				CEREBRAS_API_KEY=*|export\ CEREBRAS_API_KEY=*)
					val="${line#*=}"
					val="${val#"${val%%[![:space:]]*}"}"
					val="${val%"${val##*[![:space:]]}"}"
					case "$val" in
						\"*\") val="${val#\"}"; val="${val%\"}" ;;
						\'*\') val="${val#\'}"; val="${val%\'}" ;;
					esac
					if [ -n "$val" ]; then
						export CEREBRAS_API_KEY="$val"
						break
					fi
					;;
			esac
		done < ./.env
	fi
fi

# pi's own update banner names "pi" and suggests `pi update` — confusing under
# overclock branding (and pi isn't on PATH). The extension reports pi updates
# itself, with the right package name and upgrade path.
export PI_SKIP_VERSION_CHECK=1

# pi >= 0.75 needs node >= 22.19; an nvm install may exist without being
# loaded in this shell (e.g. GUI apps, cron, other terminals).
NODE_MAJOR="$(node -p 'parseInt(process.version.slice(1))' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 22 ]; then
	NEWEST="$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)"
	[ -n "$NEWEST" ] && export PATH="$NEWEST:$PATH"
fi

# Friendly guard: pi's arg parser treats `--session` (and friends) with no
# value as an *unknown* option — misleading, the flag exists. Catch the
# missing/flag-swallowed cases here with a clearer message. Args after `--`
# are prompt text, not flags.
seen_dd=0
for ((i=1; i<=$#; i++)); do
	arg="${!i}"
	[ "$arg" = "--" ] && seen_dd=1
	[ "$seen_dd" = 1 ] && continue
	case "$arg" in
		--session|--session-id|--session-dir|--fork)
			j=$((i + 1))
			next="${!j:-}"
			if [ -z "$next" ] || [ "${next:0:1}" = "-" ]; then
				echo "overclock: $arg requires a value — e.g. overclock --session <id> (or -r to pick a session)" >&2
				exit 1
			fi
			;;
	esac
done

# Prefer the pinned dependency. Falling back to a PATH pi means either deps are
# missing or HERE resolved wrong — warn, since a random PATH binary is both a
# version risk and a hijack surface (F3).
PI="$HERE/node_modules/.bin/pi"
if [ ! -x "$PI" ]; then
	PI="$(command -v pi || true)"
	[ -n "$PI" ] && echo "overclock: warning: using pi from PATH ($PI) — expected $HERE/node_modules/.bin/pi" >&2
fi
if [ -z "$PI" ]; then
	echo "overclock: pi not found — run 'npm install' in $HERE or install @earendil-works/pi-coding-agent" >&2
	exit 1
fi

exec "$PI" \
	--extension "$HERE/extensions/overclock" \
	--model "${OVERCLOCK_MODEL:-${FASTCODE_MODEL:-cerebras/qwen-3.8-27b}}" \
	--tools read,write,edit,bash,grep,find,ls,explore,delegate,verify \
	"$@"
