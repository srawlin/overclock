#!/usr/bin/env bash
# overclock — pi-coding-agent harness tuned for Cerebras (small-context model, fast inference)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# One-time rename migration: adopt the old fastcode state dir if it exists.
if [ ! -d "$HOME/.overclock" ] && [ -d "$HOME/.fastcode" ]; then
	mv "$HOME/.fastcode" "$HOME/.overclock"
fi

# Separate agent state (sessions, auth, settings) from a stock pi install.
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-${OVERCLOCK_AGENT_DIR:-${FASTCODE_AGENT_DIR:-$HOME/.overclock/agent}}}"
mkdir -p "$PI_CODING_AGENT_DIR"

# First-run defaults; user-editable afterwards.
if [ ! -f "$PI_CODING_AGENT_DIR/settings.json" ]; then
	cat > "$PI_CODING_AGENT_DIR/settings.json" <<'JSON'
{
  "defaultProvider": "cerebras",
  "defaultModel": "cerebras/qwen-3.8-27b",
  "defaultThinkingLevel": "low",
  "quietStartup": true
}
JSON
fi

# API key: existing env wins, else source ~/.config/overclock/env (legacy:
# ~/.config/fastcode/env), else .env in cwd.
if [ -z "${CEREBRAS_API_KEY:-}" ]; then
	for f in "$HOME/.config/fastcode/env" "$HOME/.config/overclock/env" "./.env"; do
		if [ -f "$f" ]; then
			set -a; . "$f"; set +a
		fi
	done
fi

# pi's own update banner names "pi" and suggests `pi update` — confusing under
# overclock branding (and pi isn't on PATH). The extension reports pi updates
# itself, with the right package name and upgrade path.
export PI_SKIP_VERSION_CHECK=1

# pi >= 0.75 needs node >= 22.19; an nvm install may exist without being
# loaded in this shell (e.g. GUI apps, cron, other terminals).
NODE_MAJOR="$(node -p 'parseInt(process.version.slice(1))' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 22 ]; then
	NEWEST="$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)"
	[ -n "$NEWEST" ] && export PATH="$NEWEST:$PATH"
fi

# Prefer the pinned dependency; fall back to a pi on PATH.
PI="$HERE/node_modules/.bin/pi"
[ -x "$PI" ] || PI="$(command -v pi || true)"
if [ -z "$PI" ]; then
	echo "overclock: pi not found — run 'npm install' in $HERE or install @earendil-works/pi-coding-agent" >&2
	exit 1
fi

exec "$PI" \
	--extension "$HERE/extensions/overclock" \
	--model "${OVERCLOCK_MODEL:-${FASTCODE_MODEL:-cerebras/qwen-3.8-27b}}" \
	--tools read,write,edit,bash,grep,find,ls,explore,delegate,verify \
	"$@"
